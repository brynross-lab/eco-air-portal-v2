{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/.netlify/functions/claude-proxy", "destination": "/api/claude-proxy" }
  ],
  "functions": {
    "api/claude-proxy.js": { "maxDuration": 300 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] }
  ]
}
